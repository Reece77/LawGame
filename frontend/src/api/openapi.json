{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner Track",
    "version": "0.1.0"
  },
  "paths": {
    "/api/meta": {
      "get": {
        "summary": "Get Meta",
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves": {
      "get": {
        "summary": "List Saves",
        "operationId": "listSaves",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SaveOut"
                  },
                  "type": "array",
                  "title": "Response Listsaves"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "New Game",
        "operationId": "newGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewGameIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{slug}/game": {
      "get": {
        "summary": "Get Game",
        "operationId": "getGame",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{slug}/advance": {
      "post": {
        "summary": "Advance",
        "operationId": "advance",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DifficultyOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "DifficultyOut"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "GameOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "firm_name": {
            "type": "string",
            "title": "Firm Name"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "cash_cents": {
            "type": "integer",
            "title": "Cash Cents"
          },
          "game_state": {
            "type": "string",
            "enum": [
              "active",
              "campaign_complete",
              "dissolved"
            ],
            "title": "Game State"
          },
          "turns_in_campaign": {
            "type": "integer",
            "title": "Turns In Campaign"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "firm_name",
          "turn",
          "date_label",
          "cash_cents",
          "game_state",
          "turns_in_campaign"
        ],
        "title": "GameOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetaOut": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioOut"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "difficulties": {
            "items": {
              "$ref": "#/components/schemas/DifficultyOut"
            },
            "type": "array",
            "title": "Difficulties"
          }
        },
        "type": "object",
        "required": [
          "scenarios",
          "difficulties"
        ],
        "title": "MetaOut"
      },
      "NewGameIn": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 63,
            "minLength": 1,
            "title": "Slug"
          },
          "firm_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Firm Name"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "default": "biglaw_spinout"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty",
            "default": "standard"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1.8446744073709552e+19,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "firm_name"
        ],
        "title": "NewGameIn"
      },
      "SaveOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "firm_name": {
            "type": "string",
            "title": "Firm Name"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "game_state": {
            "type": "string",
            "title": "Game State"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "firm_name",
          "turn",
          "date_label",
          "game_state"
        ],
        "title": "SaveOut"
      },
      "ScenarioOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "ScenarioOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
